TEAM_ID=

PRODUCT_NAME=ReadShelf
PRODUCT_BUNDLE_IDENTIFIER=ua.readshelf.ReadShelf$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// Shared.framework is static, so its dependencies are linked here: SQLDelight's native driver
// (SQLiter) calls the system SQLite, which the framework itself cannot pull in.
OTHER_LDFLAGS = $(inherited) -lsqlite3
